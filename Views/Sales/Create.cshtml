@model Sale
@{
    ViewData["Title"] = "New Sale";
    var medicines = ViewBag.Medicines as List<Medicine> ?? new List<Medicine>();
}

<h2 class="mb-3">New Sale</h2>
<form asp-action="Create" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Medicine</label>
            <select name="MedicineId" id="medicine" class="form-select">
                <option value="">-- Select medicine --</option>
                @foreach (var m in medicines)
                {
                    <option value="@m.Id" data-price="@m.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-stock="@m.Stock" selected="@(Model.MedicineId == m.Id)">
                        @m.Name (Stock: @m.Stock, ₹@m.Price.ToString("0.00"))
                    </option>
                }
            </select>
            <span asp-validation-for="MedicineId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Quantity</label>
            <input name="Quantity" id="qty" type="number" min="1" value="@Model.Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Total Price (₹)</label>
            <input id="total" class="form-control" value="0.00" readonly />
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Complete Sale</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        const med = document.getElementById('medicine');
        const qty = document.getElementById('qty');
        const total = document.getElementById('total');
        function calc() {
            const opt = med.options[med.selectedIndex];
            const price = parseFloat(opt.getAttribute('data-price') || '0');
            const q = parseInt(qty.value || '0');
            total.value = (price * q).toFixed(2);
        }
        med.addEventListener('change', calc);
        qty.addEventListener('input', calc);
        calc();
    </script>
}
