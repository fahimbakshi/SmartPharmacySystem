@model IEnumerable<Sale>
@{ ViewData["Title"] = "Sales"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sales</h2>
    <a asp-action="Create" class="btn btn-success">+ New Sale</a>
</div>

<div class="table-responsive">
<table class="table table-bordered table-hover bg-white">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Medicine</th>
            <th>Quantity</th>
            <th>Total (₹)</th>
            <th>Profit (₹)</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</td>
            <td>@(s.Medicine?.Name)</td>
            <td>@s.Quantity</td>
            <td>@s.TotalPrice.ToString("0.00")</td>
            <td>@s.Profit.ToString("0.00")</td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <p class="text-muted">No sales yet.</p>
}
