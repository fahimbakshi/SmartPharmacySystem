@model IEnumerable<Medicine>
@{
    ViewData["Title"] = "Medicines";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Medicines</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Medicine</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name or category" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

<div class="table-responsive">
<table class="table table-bordered table-hover align-middle bg-white">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Stock</th>
            <th>Expiry</th>
            <th>Cost (₹)</th>
            <th>Price (₹)</th>
            <th>Status</th>
            <th style="width:160px">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        var daysLeft = (m.ExpiryDate.Date - DateTime.Today).Days;
        var rowClass = daysLeft < 0 ? "table-danger" : (daysLeft <= 30 ? "table-warning" : "");
        <tr class="@rowClass">
            <td>@m.Name</td>
            <td>@m.Category</td>
            <td>@m.Stock</td>
            <td>@m.ExpiryDate.ToString("dd MMM yyyy")</td>
            <td>@m.CostPrice.ToString("0.00")</td>
            <td>@m.Price.ToString("0.00")</td>
            <td>
                @if (daysLeft < 0) { <span class="badge bg-danger">Expired</span> }
                else if (daysLeft <= 30) { <span class="badge bg-warning text-dark">Expires in @daysLeft days</span> }
                @if (m.Stock < 10) { <span class="badge bg-secondary">Low stock</span> }
                @if (daysLeft > 30 && m.Stock >= 10) { <span class="badge bg-success">OK</span> }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this medicine and its sales records?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <p class="text-muted">No medicines found.</p>
}
