@model Medicine
@{ ViewData["Title"] = "Add Medicine"; }

<h2 class="mb-3">Add Medicine</h2>
<form asp-action="Create" method="post" class="card card-body">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
